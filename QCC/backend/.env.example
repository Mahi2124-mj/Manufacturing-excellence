# Copy this file to  backend/.env  and fill in real values. Never commit backend/.env.
#
# PostgreSQL connection. Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
# A literal '@' inside the password must be URL-encoded as %40 (e.g. Priya@123 -> Priya%40123).
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/qcc

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
# Access-token lifetime in minutes.
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of frontend origins allowed by CORS (Vite dev server default below).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Outgoing email (password-reset codes) ----
# Leave SMTP_HOST empty to run without mail: the reset code is printed in the backend
# console instead of being emailed. Fill these in to send real messages.
# Gmail: use an App Password (not your normal password) with 2-Step Verification on.
# Office 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QCC Monitor <no-reply@qcc.com>
SMTP_TLS=true
# How long an emailed reset code stays valid.
RESET_CODE_TTL_MINUTES=10
